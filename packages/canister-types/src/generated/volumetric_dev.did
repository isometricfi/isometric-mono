type AcceptOfferItem = record { offer_id : nat64; quantity : nat64 };
type AcceptOffersRequest = record { items : vec AcceptOfferItem };
type AcceptOffersResponse = record {
  fill_group_id : nat64;
  active_options : vec ActiveOption;
};
type AcceptPhase = variant {
  Started;
  Failed : record { reason : text };
  CollateralLocked;
  BuyerDebited;
  TransfersComplete;
  Completed;
};
type AcceptedOffer = record {
  writer : principal;
  option_id : nat64;
  collateral_locked : nat64;
  offer_id : nat64;
  quantity : nat64;
  premium_to_writer : nat64;
  platform_fee : nat64;
};
type Account = record { owner : principal; subaccount : opt blob };
type ActiveOption = record {
  id : nat64;
  status : ActiveOptionStatus;
  option_type : OptionType;
  fill_group_id : opt nat64;
  entry_price_cents : nat64;
  asset : Asset;
  accepted_at : nat64;
  writer : principal;
  offer_id : nat64;
  quantity : nat64;
  buyer : principal;
  expiry : nat64;
  premium_paid : nat64;
  strike_price_cents : nat64;
};
type ActiveOptionStatus = variant { Active; Settling; Expired; Settled };
type Asset = variant { CkBtc };
type AuthenticatedPayload = record {
  data : AcceptOffersRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_1 = record {
  data : CancelOfferRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_2 = record {
  data : record {};
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_3 = record {
  data : CreateOfferRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_4 = record {
  data : null;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_5 = record {
  data : UpdateUsernameRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_6 = record {
  data : WithdrawCkbtcRequest;
  wallet_proof : WalletProof;
};
type BtcNetwork = variant { Mainnet; Testnet };
type CancelOfferRequest = record { offer_id : nat64 };
type ClearStorageResponse = record {
  options_cleared : nat64;
  offers_cleared : nat64;
};
type Config = record {
  ckbtc_minter : principal;
  trading_limits : TradingLimits;
  btc_network : BtcNetwork;
  ckbtc_ledger : principal;
  feature_flags : FeatureFlags;
};
type CreateOfferRequest = record {
  option_type : OptionType;
  asset : Asset;
  offer_valid_until : nat64;
  strike_basis_points : nat16;
  premium_basis_points : nat16;
  quantity : nat64;
  option_duration_seconds : nat64;
};
type CreateOfferResponse = record { offer : Offer };
type DepositInfo = record { account : Account; btc_address : text };
type ErrorDetails = record { caller : opt text };
type Event = record {
  id : nat64;
  "principal" : principal;
  data : EventData;
  timestamp : nat64;
  event_type : EventType;
};
type EventData = variant {
  AccountCreated : record { wallet_address : text };
  OfferAcceptFailed : record { offer_ids : vec nat64; reason : text };
  Deposit : record { amount_sats : nat64 };
  OfferCancelled : CancelOfferRequest;
  OfferAccepted : record {
    role : TradeRole;
    option_id : nat64;
    quantity_sats : nat64;
    offer_id : nat64;
    premium_sats : nat64;
  };
  OptionSettled : record {
    payout_sats : nat64;
    role : TradeRole;
    option_id : nat64;
    settlement_price_cents : nat64;
  };
  Withdrawal : record { destination : text; amount_sats : nat64 };
  WithdrawalFailed : record { amount_sats : nat64; reason : text };
  Unknown;
  UsernameUpdated : record { old_username : opt text; new_username : text };
  OfferCreated : record {
    duration_seconds : nat64;
    quantity_sats : nat64;
    strike_basis_points : nat16;
    offer_id : nat64;
    premium_basis_points : nat16;
  };
  OptionSettlementFailed : record { option_id : nat64; reason : text };
};
type EventType = variant {
  AccountCreated;
  OfferAcceptFailed;
  Deposit;
  OfferCancelled;
  OfferAccepted;
  OptionSettled;
  Withdrawal;
  WithdrawalFailed;
  Unknown;
  UsernameUpdated;
  OfferCreated;
  OptionSettlementFailed;
};
type FeatureFlags = record {
  is_stitching_enabled : bool;
  is_partial_filling_enabled : bool;
};
type Offer = record {
  id : nat64;
  status : OfferStatus;
  option_type : OptionType;
  asset : Asset;
  total_quantity : nat64;
  offer_valid_until : nat64;
  created_at : nat64;
  writer : principal;
  strike_basis_points : nat16;
  remaining_quantity : nat64;
  premium_basis_points : nat16;
  option_duration_seconds : nat64;
};
type OfferStatus = variant {
  Open;
  PartiallyFilled;
  Filled;
  Cancelled;
  Processing;
};
type OptionType = variant { Call };
type PendingAccept = record {
  id : nat64;
  updated_at : nat64;
  fill_group_id : nat64;
  offers : vec AcceptedOffer;
  created_at : nat64;
  buyer : principal;
  phase : AcceptPhase;
  total_premium : nat64;
};
type PendingSettlement = record {
  updated_at : nat64;
  payout_to_buyer : nat64;
  created_at : nat64;
  writer : principal;
  option_id : nat64;
  buyer : principal;
  phase : SettlementPhase;
  settlement_price_cents : nat64;
  payout_to_writer : nat64;
};
type PendingWithdrawal = record {
  id : nat64;
  updated_at : nat64;
  "principal" : principal;
  created_at : nat64;
  phase : WithdrawalPhase;
  created_at_time : nat64;
  amount : nat64;
  btc_address : text;
};
type ProfileInfo = record {
  "principal" : principal;
  username : opt text;
  subaccount : blob;
  address : text;
};
type Range = record { max : nat64; min : nat64 };
type Range_1 = record { max : nat16; min : nat16 };
type Result = variant { Ok : AcceptOffersResponse; Err : VolumetricError };
type Result_1 = variant { Ok; Err : VolumetricError };
type Result_10 = variant { Ok : vec PendingSettlement; Err : VolumetricError };
type Result_11 = variant { Ok : vec PendingWithdrawal; Err : VolumetricError };
type Result_12 = variant { Ok : vec Offer; Err : VolumetricError };
type Result_13 = variant { Ok : vec ActiveOption; Err : VolumetricError };
type Result_14 = variant { Ok : opt PendingSettlement; Err : VolumetricError };
type Result_15 = variant { Ok : UserBalanceInfo; Err : VolumetricError };
type Result_16 = variant { Ok : opt PendingWithdrawal; Err : VolumetricError };
type Result_17 = variant {
  Ok : SettleExpiredOptionsResponse;
  Err : VolumetricError;
};
type Result_18 = variant { Ok : SettlementResult; Err : VolumetricError };
type Result_19 = variant { Ok : ClearStorageResponse; Err : VolumetricError };
type Result_2 = variant { Ok : Offer; Err : VolumetricError };
type Result_20 = variant { Ok : ActiveOption; Err : VolumetricError };
type Result_21 = variant { Ok : vec UtxoStatus; Err : VolumetricError };
type Result_22 = variant { Ok : WithdrawResult; Err : VolumetricError };
type Result_3 = variant { Ok : nat64; Err : VolumetricError };
type Result_4 = variant { Ok : ProfileInfo; Err : VolumetricError };
type Result_5 = variant { Ok : CreateOfferResponse; Err : VolumetricError };
type Result_6 = variant { Ok : opt PendingAccept; Err : VolumetricError };
type Result_7 = variant { Ok : nat; Err : VolumetricError };
type Result_8 = variant { Ok : DepositInfo; Err : VolumetricError };
type Result_9 = variant { Ok : vec PendingAccept; Err : VolumetricError };
type SettleExpiredOptionsResponse = record {
  settled : vec SettlementResult;
  errors : vec text;
};
type SettlementPhase = variant {
  Started;
  Failed : record { reason : text };
  TransferComplete;
  BalanceReleased;
  Completed;
};
type SettlementResult = record {
  status : ActiveOptionStatus;
  payout_to_buyer : nat64;
  option_id : nat64;
  settlement_price_cents : nat64;
  payout_to_writer : nat64;
};
type TradeRole = variant { Buyer; Writer };
type TradingLimits = record {
  term_days : Range;
  deposit_amount_sats : nat64;
  withdraw_amount_sats : nat64;
  quantity_sats : Range;
  strike_basis_points : Range_1;
  premium_basis_points : Range_1;
  option_duration_seconds : Range;
};
type UpdateUsernameRequest = record { username : text };
type UserBalanceInfo = record {
  total : nat64;
  locked : nat64;
  available : nat64;
};
type UserInfo = record {
  "principal" : principal;
  username : opt text;
  address : text;
};
type Utxo = record { height : nat32; value : nat64; outpoint : UtxoOutpoint };
type UtxoOutpoint = record { txid : blob; vout : nat32 };
type UtxoStatus = variant {
  ValueTooSmall : Utxo;
  Tainted : Utxo;
  Minted : record { minted_amount : nat64; block_index : nat64; utxo : Utxo };
  Checked : Utxo;
};
type VolumetricError = record {
  code : nat32;
  name : text;
  message : text;
  details : opt ErrorDetails;
};
type WalletProof = record { signature : text; address : text };
type WithdrawCkbtcRequest = record { amount : nat64; btc_address : text };
type WithdrawResult = record { block_index : nat64 };
type WithdrawalPhase = variant {
  Started;
  Failed : record { reason : text };
  RetrieveRequested : record { block_index : nat64 };
  Approved;
  Completed : record { block_index : nat64 };
};
service : (opt BtcNetwork) -> {
  accept_offers : (AuthenticatedPayload) -> (Result);
  add_whitelisted : (principal) -> (Result_1);
  cancel_offer : (AuthenticatedPayload_1) -> (Result_2);
  cleanup_old_events : () -> (Result_3);
  create_account : (AuthenticatedPayload_2) -> (Result_4);
  create_offer : (AuthenticatedPayload_3) -> (Result_5);
  get_accept_by_id : (nat64) -> (Result_6) query;
  get_accept_offers_message : (text, vec AcceptOfferItem) -> (text) query;
  get_account_info : (text) -> (opt ProfileInfo) query;
  get_account_nonce : (text) -> (nat64) query;
  get_active_option_by_id : (nat64) -> (opt ActiveOption) query;
  get_all_events : (opt nat64, opt nat32) -> (vec Event) query;
  get_cancel_offer_message : (text, nat64) -> (text) query;
  get_ckbtc_balance : (text) -> (Result_7);
  get_config : () -> (Config) query;
  get_create_offer_message : (text, nat64, nat16, nat16) -> (text) query;
  get_deposit_address : (text) -> (Result_8);
  get_events_for_principal : (principal, opt nat64, opt nat32) -> (
      vec Event,
    ) query;
  get_events_since : (nat64, opt nat32) -> (vec Event) query;
  get_failed_accepts : () -> (Result_9) query;
  get_failed_settlements : () -> (Result_10) query;
  get_failed_withdrawals : () -> (Result_11) query;
  get_feature_flags : () -> (FeatureFlags) query;
  get_message_to_sign : (text) -> (text) query;
  get_my_events : (opt nat64, opt nat32) -> (vec Event) query;
  get_my_offers : (text) -> (Result_12) query;
  get_my_options : (text) -> (Result_13) query;
  get_my_pending_withdrawals : (AuthenticatedPayload_4) -> (Result_11) query;
  get_my_written_options : (text) -> (Result_13) query;
  get_offer_by_id : (nat64) -> (opt Offer) query;
  get_open_offers : () -> (vec Offer) query;
  get_pending_accepts : () -> (Result_9) query;
  get_pending_settlements : () -> (vec ActiveOption) query;
  get_pending_settlements_journal : () -> (Result_10) query;
  get_pending_withdrawals : () -> (Result_11) query;
  get_platform_fee_info : () -> (nat64, nat64) query;
  get_settlement_by_id : (nat64) -> (Result_14) query;
  get_trading_limits : () -> (TradingLimits) query;
  get_user_balance : (text) -> (Result_15) query;
  get_username_update_message : (text, text) -> (text) query;
  get_withdraw_message : (text, text, nat64) -> (text) query;
  get_withdrawal_by_id : (nat64) -> (Result_16) query;
  greet : (text) -> (text) query;
  list_users : () -> (vec UserInfo) query;
  list_whitelisted : () -> (vec principal) query;
  remove_whitelisted : (principal) -> (Result_1);
  set_feature_flags : (FeatureFlags) -> (Result_1);
  set_oracle_price : (nat64) -> (Result_1);
  set_trading_limits : (TradingLimits) -> (Result_1);
  settle_expired_options : () -> (Result_17);
  settle_option_by_id : (nat64) -> (Result_18);
  // Testing endpoint to clear all offers and active options from storage.
  // Use this for storage migration when schema changes break deserialization.
  testing_clear_offers_and_options : () -> (Result_19);
  testing_expire_option : (nat64) -> (Result_20);
  testing_force_settle : (nat64) -> (Result_18);
  testing_set_option_expiry : (nat64, nat64) -> (Result_20);
  testing_sync_balance_from_ledger : (text) -> (Result_3);
  update_ckbtc_balance : (text) -> (Result_21);
  update_username : (AuthenticatedPayload_5) -> (Result_4);
  withdraw_ckbtc : (AuthenticatedPayload_6) -> (Result_22);
}
