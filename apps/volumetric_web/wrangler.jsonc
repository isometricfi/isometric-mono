{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volumetric-web-dev",
  "main": "./worker.ts",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "keep_names": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "volumetric-web-dev"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "volumetric_d1_db",
      "database_id": "626bd0d6-2f2b-4821-86af-366b021db87c",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "volumetric-web-dev",
      "vars": {
        "TURBO_TELEMETRY_DISABLED": "1",
        "DO_NOT_TRACK": "1",
        "IC_HOST": "https://ic0.app",
        "NEXT_PUBLIC_BASE_URL": "https://dev.isometric.fi",
        "NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID": "9d34253b-1be6-45d1-b781-c26f0feea824",
        "OTEL_SERVICE_NAME": "volumetric-web-dev",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/traces",
        "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/logs",
        "MEMPOOL_API_URL": "https://mempool.space/testnet/api",
        "NEXT_PUBLIC_MEMPOOL_URL": "https://mempool.space",
        "CANISTER_ID": "4dqqd-aqaaa-aaaae-qgbta-cai",
        "CKBTC_MINTER_CANISTER_ID": "ml52i-qqaaa-aaaar-qaaba-cai",
        "CKBTC_LEDGER_CANISTER_ID": "mc6ru-gyaaa-aaaar-qaaaq-cai"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "volumetric-web-dev"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "volumetric_d1_db",
          "database_id": "626bd0d6-2f2b-4821-86af-366b021db87c",
          "migrations_dir": "drizzle/migrations"
        }
      ]
    },
    "production": {
      "name": "volumetric-web-production",
      "vars": {
        "TURBO_TELEMETRY_DISABLED": "1",
        "DO_NOT_TRACK": "1",
        "IC_HOST": "https://ic0.app",
        "NEXT_PUBLIC_BASE_URL": "https://isometric.fi",
        "NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID": "37dc9ae9-e6ad-4dc7-b196-1c5f02b0938b",
        "OTEL_SERVICE_NAME": "volumetric-web-prod",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/traces",
        "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/logs",
        "MEMPOOL_API_URL": "https://luminex.mempool.space/api",
        "NEXT_PUBLIC_MEMPOOL_URL": "https://mempool.space",
        "CANISTER_ID": "5optx-3iaaa-aaaae-qjwsa-cai",
        "CKBTC_MINTER_CANISTER_ID": "mqygn-kiaaa-aaaar-qaadq-cai",
        "CKBTC_LEDGER_CANISTER_ID": "mxzaz-hqaaa-aaaar-qaada-cai",
        "NEXT_PUBLIC_TAWK_EMBED_URL": "https://embed.tawk.to/69a303f652cbb51c37094784/1jiicevko",
        "NEXT_PUBLIC_APP_HOST": "app.isometric.fi",
        "NEXT_PUBLIC_APP_URL": "https://app.isometric.fi",
        "NEXT_PUBLIC_LANDING_PAGE_HOST": "isometric.fi",
        "NEXT_PUBLIC_WAITLIST_MODE": "true"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "volumetric-web-production"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "volumetric_d1_prod",
          "database_id": "bb200e69-caee-4241-b358-7d11efb1165a",
          "migrations_dir": "drizzle/migrations"
        }
      ]
    }
  }
}
