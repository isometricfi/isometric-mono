# Canister configuration
CANISTER_ID=
IC_HOST=https://ic0.app
NEXT_PUBLIC_BASE_URL=
# Set local replica host (e.g. http://127.0.0.1:4943) during local development.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Cloudflare D1 tooling (required for remote migration scripts)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cron job authentication
CRON_SECRET=
MEMPOOL_API_URL=https://mempool.space/testnet/api
# Production Wrangler uses https://mempool.space/api
NEXT_PUBLIC_MEMPOOL_URL=https://mempool.space/

# OpenTelemetry traces
OTEL_SERVICE_NAME=volumetric-web-local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>

# Tawk.io
NEXT_PUBLIC_TAWK_EMBED_URL=
