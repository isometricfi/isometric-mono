meta {
  name: Create Offer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/trpc/options.createOffer
  body: json
  auth: none
}

body:json {
  {
    "json": {
      "address": "{{address}}",
      "signature": "{{signature}}",
      "expiresAtSeconds": "{{expiresAtSeconds}}",
      "quantity": "100000",
      "strikeBasisPoints": 1000,
      "premiumBasisPoints": 500,
      "offerValidUntil": "1735689600000000000",
      "optionDurationSeconds": "86400"
    }
  }
}
