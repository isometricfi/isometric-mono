  url: {{baseUrl}}/api/trpc/options.cancelOffer
  body: json
  auth: none
}

body:json {
  {
    "json": {
      "address": "{{address}}",
      "signature": "{{signature}}",
      "expiresAtSeconds": "{{expiresAtSeconds}}",
      "offerId": "1"
    }
  }
}
