meta {
  name: Accept Offers
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/trpc/options.acceptOffers
  body: json
  auth: none
}

body:json {
  {
    "json": {
      "address": "{{address}}",
      "signature": "{{signature}}",
      "expiresAtSeconds": "{{expiresAtSeconds}}",
      "items": [
        {
          "offerId": "1",
          "quantity": "50000"
        }
      ]
    }
  }
}
