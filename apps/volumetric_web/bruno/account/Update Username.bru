meta {
  name: Update Username
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/trpc/account.updateUsername
  body: json
  auth: none
}

body:json {
  {
    "json": {
      "address": "{{address}}",
      "signature": "{{signature}}",
      "expiresAtSeconds": "{{expiresAtSeconds}}",
      "username": "{{username}}"
    }
  }
}

vars:pre-request {
  username: dylan
}
