meta {
  name: Withdraw
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/trpc/account.withdraw
  body: json
  auth: none
}

body:json {
  {
    "json": {
      "address": "{{address}}",
      "signature": "{{signature}}",
      "btcAddress": "{{btcAddress}}",
      "amount": "{{amount}}"
    }
  }
}
