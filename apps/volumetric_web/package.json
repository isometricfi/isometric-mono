{
  "name": "@volumetric/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4200",
    "build": "next build",
    "start": "next start --port ${PORT:-4200}",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "wrangler dev",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev",
    "cf:deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf:deploy-cron:dev": "wrangler deploy --config workers/wrangler-cron.jsonc --env dev",
    "cf:deploy-cron:prod": "wrangler deploy --config workers/wrangler-cron.jsonc --env production",
    "cf:deploy-all:dev": "pnpm cf:deploy:dev && pnpm cf:deploy-cron:dev",
    "cf:deploy-all:prod": "pnpm cf:deploy:prod && pnpm cf:deploy-cron:prod",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply volumetric_d1_db --local",
    "db:migrate:remote:dev": "wrangler d1 migrations apply volumetric_d1_db --remote --env dev",
    "db:migrate:remote:prod": "wrangler d1 migrations apply volumetric_d1_prod --remote --env production",
    "db:migrate:status:dev": "wrangler d1 migrations list volumetric_d1_db --remote --env dev",
    "db:migrate:status:prod": "wrangler d1 migrations list volumetric_d1_prod --remote --env production"
  },
  "dependencies": {
    "@icp-sdk/core": "^5.4.0",
    "@dynamic-labs/bitcoin": "^4.79.0",
    "@dynamic-labs/sdk-react-core": "^4.79.0",
    "@microlabs/otel-cf-workers": "1.0.0-rc.52",
    "@opentelemetry/api": "^1.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.8.1",
    "@trpc/next": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@trpc/tanstack-react-query": "^11.8.1",
    "@types/three": "^0.184.0",
    "@volumetric/canister-types": "workspace:*",
    "@volumetric/telemetry": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "facehash": "^0.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.556.0",
    "motion": "^12.38.0",
    "next": "16.0.10",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.0",
    "react-qr-code": "^2.0.18",
    "react-responsive": "^10.0.1",
    "react-use-measure": "^2.1.7",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "three": "^0.184.0",
    "vaul": "^1.1.2",
    "zod": "4.0.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "@opennextjs/cloudflare": "^1.14.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^2.1.1",
    "agentation-mcp": "^1.1.0",
    "bip39": "^3.1.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.54.0"
  }
}
