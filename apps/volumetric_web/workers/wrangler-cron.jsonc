{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "volumetric-cron-dev",
  "main": "cron-worker.ts",
  "compatibility_date": "2025-01-03",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "NEXT_APP",
      "service": "volumetric-web-dev"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *"]
  },
  "env": {
    "dev": {
      "name": "volumetric-cron-dev",
      "services": [
        {
          "binding": "NEXT_APP",
          "service": "volumetric-web-dev"
        }
      ]
    },
    "production": {
      "name": "volumetric-cron-production",
      "services": [
        {
          "binding": "NEXT_APP",
          "service": "volumetric-web-production"
        }
      ]
    }
  }
}
