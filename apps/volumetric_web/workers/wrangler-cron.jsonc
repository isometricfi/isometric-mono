{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "volumetric-cron-dev",
  "main": "cron-worker.ts",
  "compatibility_date": "2025-01-03",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "NEXT_APP",
      "service": "volumetric-web-dev"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "env": {
    "dev": {
      "name": "volumetric-cron-dev",
      "vars": {
        "TURBO_TELEMETRY_DISABLED": "1",
        "DO_NOT_TRACK": "1",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/traces",
        "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/logs"
      },
      "services": [
        {
          "binding": "NEXT_APP",
          "service": "volumetric-web-dev"
        }
      ]
    },
    "production": {
      "name": "volumetric-cron-production",
      "vars": {
        "TURBO_TELEMETRY_DISABLED": "1",
        "DO_NOT_TRACK": "1",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/traces",
        "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://otlp-gateway-prod-eu-central-0.grafana.net/otlp/v1/logs"
      },
      "services": [
        {
          "binding": "NEXT_APP",
          "service": "volumetric-web-production"
        }
      ]
    }
  }
}
