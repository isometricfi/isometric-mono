type AcceptOfferItem = record { offer_id : nat64; quantity : nat64 };
type AcceptOffersReceipt = record {
  accept_journal_entry_id : nat64;
  fill_group_id : nat64;
  operation_id : blob;
};
type AcceptOffersRequest = record {
  expires_at_seconds : nat64;
  items : vec AcceptOfferItem;
};
type AcceptOffersResult = record {
  fill_group_id : nat64;
  active_options : vec ActiveOption;
};
type AcceptOffersStatus = variant {
  Failed : record { receipt : AcceptOffersReceipt; message : text };
  RecoveryRequired : record {
    last_error : opt text;
    receipt : AcceptOffersReceipt;
    phase : AcceptPhase;
  };
  RetryRequired : record {
    last_error : opt text;
    receipt : AcceptOffersReceipt;
    phase : AcceptPhase;
    next_attempt_at_seconds : nat64;
  };
  Succeeded : record {
    result : AcceptOffersResult;
    receipt : AcceptOffersReceipt;
  };
  Pending : record {
    last_error : opt text;
    receipt : AcceptOffersReceipt;
    phase : AcceptPhase;
  };
};
type AcceptPhase = variant {
  Started;
  Failed : record { reason : text };
  CollateralLocked;
  BuyerDebited;
  TransfersComplete;
  Completed;
};
type AcceptedOffer = record {
  writer : principal;
  option_id : nat64;
  collateral_locked : nat64;
  offer_id : nat64;
  quantity : nat64;
  premium_to_writer : nat64;
  platform_fee : nat64;
};
type Account = record { owner : principal; subaccount : opt blob };
type ActiveOption = record {
  id : nat64;
  status : ActiveOptionStatus;
  expiry_seconds : nat64;
  option_type : OptionType;
  fill_group_id : opt nat64;
  entry_price_cents : nat64;
  asset : Asset;
  writer : principal;
  offer_id : nat64;
  profit_fee_basis_points : nat64;
  quantity : nat64;
  accepted_at_seconds : nat64;
  buyer : principal;
  premium_paid : nat64;
  strike_price_cents : nat64;
};
type ActiveOptionStatus = variant { Active; Settling; Expired; Settled };
type Asset = variant { CkBtc };
type AuditExpectedTransfer = record {
  to : Account;
  created_at_time_ns : nat64;
  from : Account;
  kind : AuditTransferKind;
  memo : blob;
  note : text;
  operation_id : blob;
  amount_sats : nat64;
};
type AuditTransferKind = variant {
  SettlementBuyerPayout;
  SettlementProfitFee;
  InternalCollateralLock;
};
type AuditUserBalance = record {
  "principal" : principal;
  locked_as_writer_sats : nat64;
  total_sats : nat64;
  available_sats : nat64;
};
type AuthenticatedPayload = record {
  data : AcceptOffersRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_1 = record {
  data : CancelOfferRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_2 = record {
  data : CreateProfileRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_3 = record {
  data : CreateOfferRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_4 = record {
  data : ListMyPendingWithdrawalsRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_5 = record {
  data : UpdateUsernameRequest;
  wallet_proof : WalletProof;
};
type AuthenticatedPayload_6 = record {
  data : WithdrawCkbtcRequest;
  wallet_proof : WalletProof;
};
type BtcNetwork = variant { Mainnet; Testnet };
type CancelOfferRequest = record {
  expires_at_seconds : nat64;
  offer_id : nat64;
};
type Config = record {
  ckbtc_minter : principal;
  trading_limits : TradingLimits;
  btc_network : BtcNetwork;
  fee_config : FeeConfig;
  ckbtc_ledger : principal;
  feature_flags : FeatureFlags;
};
type CreateOfferRequest = record {
  option_type : OptionType;
  asset : Asset;
  offer_valid_until_seconds : nat64;
  expires_at_seconds : nat64;
  strike_basis_points : nat16;
  premium_basis_points : nat16;
  quantity : nat64;
  option_duration_seconds : nat64;
};
type CreateOfferResponse = record { offer : Offer };
type CreateProfileRequest = record {
  invite_code : opt text;
  expires_at_seconds : nat64;
};
type DepositInfo = record { account : Account; btc_address : text };
type ErrorDetails = record { caller : opt text };
type Event = record {
  id : nat64;
  "principal" : principal;
  data : EventData;
  event_type : EventType;
  timestamp_seconds : nat64;
};
type EventData = variant {
  AccountCreated : record { wallet_address : text };
  OfferAcceptFailed : record { offer_ids : vec nat64; reason : text };
  Deposit : record { amount_sats : nat64 };
  OfferCancelled : record { offer_id : nat64; remaining_quantity_sats : nat64 };
  OfferAccepted : record {
    expiry_seconds : nat64;
    fill_group_id : nat64;
    entry_price_cents : nat64;
    role : TradeRole;
    counterparty : principal;
    option_id : nat64;
    quantity_sats : nat64;
    offer_id : nat64;
    premium_sats : nat64;
    strike_price_cents : nat64;
  };
  OptionSettled : record {
    entry_price_cents : nat64;
    payout_sats : nat64;
    role : TradeRole;
    option_id : nat64;
    quantity_sats : nat64;
    accepted_at_seconds : nat64;
    settled_at_seconds : nat64;
    premium_sats : nat64;
    settlement_price_cents : nat64;
    strike_price_cents : nat64;
  };
  Withdrawal : record { destination : text; amount_sats : nat64 };
  WithdrawalFailed : record { amount_sats : nat64; reason : text };
  Unknown;
  UsernameUpdated : record { old_username : opt text; new_username : text };
  OfferCreated : record {
    duration_seconds : nat64;
    offer_valid_until_seconds : nat64;
    quantity_sats : nat64;
    strike_basis_points : nat16;
    offer_id : nat64;
    premium_basis_points : nat16;
  };
  OptionSettlementFailed : record { option_id : nat64; reason : text };
};
type EventType = variant {
  AccountCreated;
  OfferAcceptFailed;
  Deposit;
  OfferCancelled;
  OfferAccepted;
  OptionSettled;
  Withdrawal;
  WithdrawalFailed;
  Unknown;
  UsernameUpdated;
  OfferCreated;
  OptionSettlementFailed;
};
type FeatureFlags = record {
  is_stitching_enabled : bool;
  is_partial_filling_enabled : bool;
};
type FeeConfig = record {
  premium_fee_basis_points : nat64;
  fee_recipient : principal;
  profit_fee_basis_points : nat64;
};
type ListMyPendingWithdrawalsRequest = record { expires_at_seconds : nat64 };
type ObservabilityMetrics = record {
  failed_accepts_total : nat64;
  balances_total : nat64;
  stable_memory_pages : nat64;
  stable_memory_bytes : nat64;
  failed_withdrawals_total : nat64;
  open_offers_total : nat64;
  profiles_total : nat64;
  whitelist_entries_total : nat64;
  pending_settlements_total : nat64;
  signature_nonces_total : nat64;
  pending_accepts_total : nat64;
  events_total : nat64;
  wallet_registrations_total : nat64;
  pending_withdrawals_total : nat64;
  active_options_total : nat64;
  failed_settlements_total : nat64;
  offers_total : nat64;
};
type Offer = record {
  id : nat64;
  status : OfferStatus;
  option_type : OptionType;
  asset : Asset;
  total_quantity : nat64;
  offer_valid_until_seconds : nat64;
  writer : principal;
  strike_basis_points : nat16;
  remaining_quantity : nat64;
  premium_basis_points : nat16;
  created_at_seconds : nat64;
  option_duration_seconds : nat64;
};
type OfferStatus = variant {
  Open;
  PartiallyFilled;
  Filled;
  Cancelled;
  Processing;
};
type OptionAuditReport = record {
  writer_balance : opt AuditUserBalance;
  option : opt ActiveOption;
  option_events : vec Event;
  expected_transfers : vec AuditExpectedTransfer;
  option_id : nat64;
  buyer_balance : opt AuditUserBalance;
  settlement : opt PendingSettlement;
};
type OptionType = variant { Call };
type PendingAccept = record {
  id : nat64;
  fill_group_id : nat64;
  entry_price_cents : opt nat64;
  updated_at_seconds : nat64;
  offers : vec AcceptedOffer;
  created_at_seconds : nat64;
  buyer : principal;
  phase : AcceptPhase;
  total_buyer_debit_required_sats : nat64;
  platform_fee_collected : opt bool;
};
type PendingSettlement = record {
  updated_at_seconds : nat64;
  payout_to_buyer : nat64;
  writer : principal;
  option_id : nat64;
  created_at_seconds : nat64;
  buyer : principal;
  phase : SettlementPhase;
  settlement_price_cents : nat64;
  payout_to_writer : nat64;
};
type PendingWithdrawal = record {
  id : nat64;
  "principal" : principal;
  updated_at_seconds : nat64;
  created_at_time_ns : nat64;
  created_at_seconds : nat64;
  phase : WithdrawalPhase;
  amount : nat64;
  btc_address : text;
};
type ProfileInfo = record {
  "principal" : principal;
  username : opt text;
  referral_count : opt nat64;
  subaccount : blob;
  invite_code : opt text;
  address : text;
};
type Range = record { max : nat64; min : nat64 };
type Range_1 = record { max : nat16; min : nat16 };
type Result = variant { Ok : AcceptOffersReceipt; Err : VolumetricError };
type Result_1 = variant { Ok; Err : VolumetricError };
type Result_10 = variant { Ok : vec Event; Err : VolumetricError };
type Result_11 = variant { Ok : nat; Err : VolumetricError };
type Result_12 = variant { Ok : DepositInfo; Err : VolumetricError };
type Result_13 = variant { Ok : vec PendingAccept; Err : VolumetricError };
type Result_14 = variant { Ok : vec PendingSettlement; Err : VolumetricError };
type Result_15 = variant { Ok : vec PendingWithdrawal; Err : VolumetricError };
type Result_16 = variant { Ok : vec Offer; Err : VolumetricError };
type Result_17 = variant { Ok : vec ActiveOption; Err : VolumetricError };
type Result_18 = variant { Ok : OptionAuditReport; Err : VolumetricError };
type Result_19 = variant { Ok : vec blob; Err : VolumetricError };
type Result_2 = variant { Ok : Offer; Err : VolumetricError };
type Result_20 = variant { Ok : opt PendingSettlement; Err : VolumetricError };
type Result_21 = variant { Ok : SettlementStatus; Err : VolumetricError };
type Result_22 = variant { Ok : UserBalanceInfo; Err : VolumetricError };
type Result_23 = variant { Ok : WithdrawStatus; Err : VolumetricError };
type Result_24 = variant { Ok : opt PendingWithdrawal; Err : VolumetricError };
type Result_25 = variant { Ok : vec UserInfo; Err : VolumetricError };
type Result_26 = variant { Ok : vec principal; Err : VolumetricError };
type Result_27 = variant { Ok : ObservabilityMetrics; Err : VolumetricError };
type Result_28 = variant { Ok : WalExecutionOutcome; Err : VolumetricError };
type Result_29 = variant {
  Ok : SettleExpiredOptionsResponse;
  Err : VolumetricError;
};
type Result_3 = variant { Ok : nat64; Err : VolumetricError };
type Result_30 = variant { Ok : SettlementReceipt; Err : VolumetricError };
type Result_31 = variant { Ok : vec UtxoStatus; Err : VolumetricError };
type Result_32 = variant { Ok : WithdrawReceipt; Err : VolumetricError };
type Result_4 = variant { Ok : ProfileInfo; Err : VolumetricError };
type Result_5 = variant { Ok : CreateOfferResponse; Err : VolumetricError };
type Result_6 = variant { Ok : opt PendingAccept; Err : VolumetricError };
type Result_7 = variant { Ok : text; Err : VolumetricError };
type Result_8 = variant { Ok : AcceptOffersStatus; Err : VolumetricError };
type Result_9 = variant { Ok : opt ProfileInfo; Err : VolumetricError };
type SettleExpiredOptionsResponse = record {
  settled : vec SettlementResult;
  errors : vec text;
};
type SettlementPhase = variant {
  Started;
  ProfitFeeCollected;
  Failed : record { reason : text };
  TransferComplete;
  BalanceReleased;
  WriterPayoutReleased;
  Completed;
};
type SettlementReceipt = record { operation_id : blob; option_id : nat64 };
type SettlementResult = record {
  status : ActiveOptionStatus;
  payout_to_buyer : nat64;
  option_id : nat64;
  settlement_price_cents : nat64;
  payout_to_writer : nat64;
};
type SettlementStatus = variant {
  Failed : record { receipt : SettlementReceipt; message : text };
  RecoveryRequired : record {
    last_error : opt text;
    receipt : SettlementReceipt;
    phase : SettlementPhase;
  };
  RetryRequired : record {
    last_error : opt text;
    receipt : SettlementReceipt;
    phase : SettlementPhase;
    next_attempt_at_seconds : nat64;
  };
  Succeeded : record {
    result : SettlementWalResult;
    receipt : SettlementReceipt;
  };
  Pending : record {
    last_error : opt text;
    receipt : SettlementReceipt;
    phase : SettlementPhase;
  };
};
type SettlementWalResult = record { option_id : nat64 };
type StoredXrcBtcUsdRate = record {
  decimals : nat32;
  price_cents : nat64;
  xrc_timestamp_seconds : nat64;
  fetched_at_seconds : nat64;
};
type TradeRole = variant { Buyer; Writer };
type TradingLimits = record {
  create_offer_quantity_sats : Range;
  deposit_amount_sats : nat64;
  accept_offer_quantity_sats : Range;
  max_offers_per_term : nat64;
  withdraw_amount_sats : nat64;
  strike_basis_points : Range_1;
  premium_basis_points : Range_1;
  option_duration_seconds : Range;
};
type UpdateUsernameRequest = record {
  username : text;
  expires_at_seconds : nat64;
};
type UserBalanceInfo = record {
  total : nat64;
  locked : nat64;
  available : nat64;
};
type UserInfo = record {
  "principal" : principal;
  username : opt text;
  address : text;
};
type Utxo = record { height : nat32; value : nat64; outpoint : UtxoOutpoint };
type UtxoOutpoint = record { txid : blob; vout : nat32 };
type UtxoStatus = variant {
  ValueTooSmall : Utxo;
  Tainted : Utxo;
  Minted : record { minted_amount : nat64; block_index : nat64; utxo : Utxo };
  Checked : Utxo;
};
type VolumetricError = record {
  code : nat32;
  name : text;
  message : text;
  details : opt ErrorDetails;
};
type WalExecutionOutcome = variant {
  SucceededAlready;
  RecoveryRequired : text;
  FailedPermanent : text;
  RetryRequired : text;
  Succeeded;
  SkippedAlreadyInFlight;
};
type WalletProof = record { signature : text; address : text };
type WithdrawCkbtcRequest = record {
  expires_at_seconds : nat64;
  amount : nat64;
};
type WithdrawReceipt = record { withdrawal_id : nat64; operation_id : blob };
type WithdrawResult = record { block_index : nat64 };
type WithdrawStatus = variant {
  Failed : record { receipt : WithdrawReceipt; message : text };
  RecoveryRequired : record {
    last_error : opt text;
    receipt : WithdrawReceipt;
    phase : WithdrawalPhase;
  };
  Succeeded : record { result : WithdrawResult; receipt : WithdrawReceipt };
  Pending : record {
    last_error : opt text;
    receipt : WithdrawReceipt;
    phase : WithdrawalPhase;
  };
};
type WithdrawalPhase = variant {
  Started;
  Failed : record { reason : text };
  RetrieveRequested : WithdrawResult;
  Approved;
  Completed : WithdrawResult;
};
service : (opt BtcNetwork) -> {
  accept_offers : (AuthenticatedPayload) -> (Result);
  add_whitelisted : (principal) -> (Result_1);
  cancel_offer : (AuthenticatedPayload_1) -> (Result_2);
  cleanup_old_events : () -> (Result_3);
  clear_all_events : () -> (Result_3);
  clear_log_access_token : () -> (Result_1);
  create_account : (AuthenticatedPayload_2) -> (Result_4);
  create_offer : (AuthenticatedPayload_3) -> (Result_5);
  get_accept_by_id : (nat64) -> (Result_6) query;
  get_accept_offers_message : (text, vec AcceptOfferItem, nat64) -> (
      Result_7,
    ) query;
  get_accept_status : (blob) -> (Result_8) query;
  get_account_info : (text, bool) -> (Result_9) query;
  get_account_nonce : (text) -> (Result_3) query;
  get_active_option_by_id : (nat64) -> (opt ActiveOption) query;
  get_active_options : () -> (vec ActiveOption) query;
  get_all_events : (opt nat64, opt nat32) -> (Result_10) query;
  get_cancel_offer_message : (text, nat64, nat64) -> (Result_7) query;
  get_ckbtc_balance : (text) -> (Result_11);
  get_config : () -> (Config) query;
  get_create_offer_message : (
      text,
      nat64,
      nat16,
      nat16,
      nat64,
      nat64,
      nat64,
    ) -> (Result_7) query;
  get_deposit_address : (text) -> (Result_12);
  get_events_for_principal : (principal, opt nat64, opt nat32) -> (
      Result_10,
    ) query;
  get_events_since : (nat64, opt nat32) -> (Result_10) query;
  get_failed_accepts : () -> (Result_13) query;
  get_failed_settlements : () -> (Result_14) query;
  get_failed_withdrawals : () -> (Result_15) query;
  get_feature_flags : () -> (FeatureFlags) query;
  get_fee_config : () -> (FeeConfig) query;
  get_latest_xrc_btc_usd_rate : () -> (opt StoredXrcBtcUsdRate) query;
  get_message_to_sign : (text, opt text, nat64) -> (Result_7) query;
  get_my_events : (opt nat64, opt nat32) -> (vec Event) query;
  get_my_offers : (text) -> (Result_16) query;
  get_my_options : (text) -> (Result_17) query;
  get_my_pending_withdrawals : (AuthenticatedPayload_4) -> (Result_15) query;
  get_my_pending_withdrawals_message : (text, nat64) -> (Result_7) query;
  get_my_written_options : (text) -> (Result_17) query;
  get_offer_by_id : (nat64) -> (opt Offer) query;
  get_open_offers : () -> (vec Offer) query;
  get_option_audit_report : (nat64) -> (Result_18) query;
  get_pending_accepts : () -> (Result_13) query;
  get_pending_settlements : () -> (Result_17) query;
  get_pending_settlements_journal : () -> (Result_14) query;
  get_pending_withdrawals : () -> (Result_15) query;
  get_platform_fees_collected_total : () -> (nat64) query;
  get_recovery_required_wal_entries : (nat32) -> (Result_19) query;
  get_retry_required_wal_entries : (nat32) -> (Result_19) query;
  get_settlement_by_id : (nat64) -> (Result_20) query;
  get_settlement_status : (blob) -> (Result_21) query;
  get_trading_limits : () -> (TradingLimits) query;
  get_user_balance : (text) -> (Result_22) query;
  get_username_update_message : (text, text, nat64) -> (Result_7) query;
  get_withdraw_message : (text, nat64, nat64) -> (Result_7) query;
  get_withdraw_status : (blob) -> (Result_23) query;
  get_withdrawal_by_id : (nat64) -> (Result_24) query;
  list_users : () -> (Result_25) query;
  list_whitelisted : () -> (Result_26) query;
  observability_get_metrics : () -> (Result_27) query;
  recover_wal_operation : (blob) -> (Result_28);
  remove_whitelisted : (principal) -> (Result_1);
  resolve_invite_code : (text) -> (opt text) query;
  set_accept_offer_quantity_sats_range_config : (nat64, nat64) -> (Result_1);
  set_create_offer_quantity_sats_range_config : (nat64, nat64) -> (Result_1);
  set_deposit_amount_sats_config : (nat64) -> (Result_1);
  set_feature_flags_config : (FeatureFlags) -> (Result_1);
  set_fee_config_config : (FeeConfig) -> (Result_1);
  set_fee_recipient_config : (principal) -> (Result_1);
  set_log_access_token : (text) -> (Result_1);
  set_max_offers_per_term_config : (nat64) -> (Result_1);
  set_option_duration_seconds_range_config : (nat64, nat64) -> (Result_1);
  set_premium_basis_points_range_config : (nat16, nat16) -> (Result_1);
  set_premium_fee_basis_points_config : (nat64) -> (Result_1);
  set_profit_fee_basis_points_config : (nat64) -> (Result_1);
  set_quantity_sats_range_config : (nat64, nat64) -> (Result_1);
  set_strike_basis_points_range_config : (nat16, nat16) -> (Result_1);
  set_trading_limits_config : (TradingLimits) -> (Result_1);
  set_withdraw_amount_sats_config : (nat64) -> (Result_1);
  settle_expired_options : () -> (Result_29);
  settle_option_by_id : (nat64) -> (Result_30);
  update_ckbtc_balance : (text) -> (Result_31);
  update_username : (AuthenticatedPayload_5) -> (Result_4);
  validate_invite_code : (text, text) -> (bool) query;
  withdraw_ckbtc : (AuthenticatedPayload_6) -> (Result_32);
}
