{
  "name": "@volumetric/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "bot": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "worker:dev": "wrangler dev",
    "worker:dev:bot1": "wrangler dev --env bot1",
    "worker:dev:bot2": "wrangler dev --env bot2",
    "worker:dev:bot3": "wrangler dev --env bot3",
    "worker:dev:bot4": "wrangler dev --env bot4",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:bot1": "wrangler deploy --env bot1",
    "worker:deploy:bot2": "wrangler deploy --env bot2",
    "worker:deploy:bot3": "wrangler deploy --env bot3",
    "worker:deploy:bot4": "wrangler deploy --env bot4",
    "worker:deploy:all": "pnpm worker:deploy:bot1 && pnpm worker:deploy:bot2 && pnpm worker:deploy:bot3 && pnpm worker:deploy:bot4",
    "worker:tail:bot1": "wrangler tail --env bot1",
    "worker:tail:bot2": "wrangler tail --env bot2",
    "worker:tail:bot3": "wrangler tail --env bot3",
    "worker:tail:bot4": "wrangler tail --env bot4",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@bitcoin-js/tiny-secp256k1-asmjs": "^2.2.4",
    "@dfinity/agent": "^2.2.0",
    "@dfinity/candid": "^2.2.0",
    "@dfinity/principal": "^2.2.0",
    "@microlabs/otel-cf-workers": "1.0.0-rc.52",
    "@opentelemetry/api": "^1.9.0",
    "@trpc/client": "^11.0.0",
    "@volumetric/canister-types": "workspace:*",
    "@volumetric/telemetry": "workspace:*",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.5",
    "bitcoinjs-message": "^2.2.0",
    "dotenv": "^16.4.7",
    "ecpair": "^3.0.1",
    "superjson": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.59.1"
  }
}
