# Bot wallet seed phrase (BIP39 12/24 words)
BOT_SEED_PHRASE="your twelve word seed phrase goes here for the bot wallet"

# Web app tRPC endpoint
TRPC_URL=http://localhost:3000/api/trpc

# ICP canister config
CANISTER_ID=your-canister-id
IC_HOST=https://ic0.app

# BTC network: "mainnet" or "testnet"
BTC_NETWORK=mainnet

# Bot loop interval in milliseconds (default: 60000 = 1 minute)
INTERVAL_MS=60000

# Bot name (used in logs and traces)
BOT_NAME=bot-1

# OpenTelemetry exporter endpoint (optional, logs to console if not set)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
