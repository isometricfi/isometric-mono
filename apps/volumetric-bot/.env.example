# Bot wallet private key in WIF format
BOT_PRIVATE_KEY_WIF="your-wif-private-key-goes-here"

# Web app tRPC endpoint
TRPC_URL=http://localhost:4200/api/trpc

# ICP canister config
CANISTER_ID=your-canister-id
IC_HOST=https://ic0.app

# BTC network: "mainnet" or "testnet"
BTC_NETWORK=testnet

# Bot loop interval in milliseconds (default: 60000 = 1 minute)
INTERVAL_MS=60000

# Bot name (used in logs and traces)
BOT_NAME=bot-1

# OpenTelemetry service name (optional)
OTEL_SERVICE_NAME=volumetric-bot

# OpenTelemetry trace endpoint (optional)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# OpenTelemetry log endpoint (optional)
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs

# Shared OTLP auth header (k=v format, URL-encoded)
OTEL_EXPORTER_AUTH=Authorization=Basic%20<base64>
